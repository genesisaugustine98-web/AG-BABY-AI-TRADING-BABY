# Research/control-plane integrations. Never commit real secrets.
EXECUTION_ENV=research

# GitHub Actions supplies GITHUB_REPOSITORY/GITHUB_SHA automatically.
GITHUB_REPOSITORY=genesisaugustine98-web/AG-BABY-AI-TRADING-BABY

# Hugging Face
HF_TOKEN=

# Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=

# Colab: informational flag; authentication stays in the user's Google session.
COLAB_ENABLED=false

# AWS: prefer GitHub OIDC / short-lived role credentials.
AWS_ROLE_ARN=

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Render
RENDER_API_KEY=
RENDER_SERVICE_ID=

# DigitalOcean
DIGITALOCEAN_TOKEN=

# MT5 must remain demo-only until separately approved.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
