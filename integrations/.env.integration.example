# Research/control-plane integrations. Never commit real secrets.
EXECUTION_ENV=research

# GitHub Actions supplies GITHUB_REPOSITORY/GITHUB_SHA automatically.
GITHUB_REPOSITORY=genesisaugustine98-web/AG-BABY-AI-TRADING-BABY

# Hugging Face
HF_TOKEN=

# Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=

# Colab: informational flag; authentication stays in the user's Google session.
COLAB_ENABLED=false

# AWS: prefer GitHub OIDC / short-lived role credentials.
AWS_ROLE_ARN=

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free research fabric
BINANCE_SYMBOL=BTCUSDT
KRAKEN_FUTURES_SYMBOL=PI_XBTUSD
OBSERVATION_INTERVAL_SECONDS=60
RESEARCH_INTERVAL_SECONDS=900
RESEARCH_HORIZONS=M15,H1,H4,D1
OBSERVATION_HEALTH_BIND=127.0.0.1
OBSERVATION_HEALTH_PORT=8787
OBSERVATION_OUTPUT_DIR=/var/lib/ag-baby/observations

# Render
RENDER_API_KEY=
RENDER_SERVICE_ID=

# DigitalOcean
DIGITALOCEAN_TOKEN=

# MT5 must remain demo-only until separately approved.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
